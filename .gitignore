# No trailing slash: with one, a symlinked node_modules (the worktree recipe in
# PARALLEL.md) is not matched, and `git add -A` commits an absolute path.
node_modules
.next/
out/
build/
# Every env file is ignored. The committed template is the one exception.
.env*
!.env.example
.vercel
.DS_Store
*.log
coverage/
tmp/
_kickoff.md

# Regenerated by `next build`; committing it would point at a .next/ that a fresh clone lacks
next-env.d.ts
*.tsbuildinfo
