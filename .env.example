# All keys are OPTIONAL.
# With none of them the app still runs on Wikidata, GLEIF and SEC EDGAR. Reading people out
# of a company's own pages needs GEMINI_API_KEY: without it no page is fetched at all.
# Users can also supply their own keys at runtime through the in-app modal.

# Company enrichment — 100 free requests, non-renewing. https://www.abstractapi.com
ABSTRACT_API_KEY=

# Decision makers — 50 free credits/month. Use "test-api-key" while developing.
# https://hunter.io/api-documentation/v2
HUNTER_API_KEY=

# Web search — 1,000 free credits/month. https://www.tavily.com
TAVILY_API_KEY=

# Structured extraction from HTML. https://ai.google.dev
GEMINI_API_KEY=

# Not a key and not secret: the SEC rejects EDGAR requests that do not identify their caller.
# Optional like the rest — set it to your own contact address so the calls are attributable
# to you rather than to the default.
EDGAR_USER_AGENT="Detective Gabi contact@example.com"
